{
  "name": "esql-textmate-bundle",
  "version": "0.1.0",
  "description": "ESQL TextMate bundle for JetBrains IDEs",
  "contributes": {
    "languages": [
      {
        "id": "esql",
        "aliases": ["ES|QL", "esql"],
        "extensions": [".esql"]
      }
    ],
    "grammars": [
      {
        "language": "esql",
        "scopeName": "source.esql",
        "path": "./syntaxes/esql.tmLanguage.json"
      }
    ]
  }
}

