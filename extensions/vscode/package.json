{
  "name": "highlight-esql",
  "displayName": "Highlight ES|QL",
  "description": "Syntax highlighting for ES|QL (Elasticsearch Query Language)",
  "version": "0.0.0",
  "publisher": "Elastic",
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/elastic/esql-syntax"
  },
  "files": [
    "icon.png",
    "syntaxes/",
    "LICENSE.txt",
    "README.md"
  ],
  "scripts": {
    "vscode:prepublish": "mkdir -p syntaxes && cp ../../syntaxes/esql.tmLanguage.json syntaxes/esql.tmLanguage.json && cp ../../LICENSE.txt LICENSE.txt && npx --yes sharp-cli -i ../icon.svg -o icon.png resize 256 256"
  },
  "contributes": {
    "languages": [
      {
        "id": "esql",
        "aliases": ["ES|QL", "esql"],
        "extensions": [".esql"]
      }
    ],
    "grammars": [
      {
        "language": "esql",
        "scopeName": "source.esql",
        "path": "./syntaxes/esql.tmLanguage.json"
      }
    ]
  }
}
