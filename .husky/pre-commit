#!/usr/bin/env sh

# Auto-regenerate the TextMate grammar when its sources change.
# This ensures extensions/github/esql.tmLanguage.json is always in sync
# with src/esql-data.mjs and src/esql.tmLanguage.template.json.

if git diff --cached --name-only | grep -qE '^src/(esql-data\.js|esql\.tmLanguage\.template\.json|generate\.js)$'; then
	npm run generate
	git add extensions/github/esql.tmLanguage.json
fi
